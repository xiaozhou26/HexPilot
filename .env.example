# HexPilot API Proxy Configuration

# Server settings
SERVER_PORT=8080

# Upstream reverse API settings
UPSTREAM_API=https://your-reverse-api.com
UPSTREAM_TOKEN=your-api-token-here

# Model returned by /v1/models and used when a request omits model
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324

# Most reverse/chat APIs do not support OpenAI native tool calls.
# Leave false unless the upstream itself supports tools/tool_choice.
UPSTREAM_NATIVE_TOOLS=false

# Default AI mode: react or plan_execute
DEFAULT_MODE=react
